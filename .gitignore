# ---- The installation ----
# This repository is the root of an installation ($STELLAR_ROOT). Everything the installer and the build create
# next to the sources belongs to the machine, not to the repository.
/packages/
/manifests/
/projects/
/tools/
/config/
/artifacts/
# The monorepo tracks modules/ (modules developed here); a bare installation would ignore it.
/Docs/Modules/

# ---- Build output ----
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/

# ---- The installation ----
# This repository is the root of an installation ($STELLAR_ROOT). Everything the installer and the build create
# next to the sources belongs to the machine, not to the repository.
/modules/
/packages/
/manifests/
/projects/
/tools/
/config/
/artifacts/
/Docs/Modules/
# The modules and tools above are repositories of their own. The solution of the whole installation (core, modules
# and tools together) is generated on the machine; the core has StellarEngine-Core.sln.
/StellarEngine.sln
/StellarEngine.slnf
/StellarEngine.*.slnf
# The bare repository scripts/mirror.ps1 builds the snapshots of the orchestra in
/.mirror/
# The DocFX project of the orchestra site, generated by scripts/orchestra-site.ps1
/docfx.orchestra.json

# ---- Build output ----
[Bb]in/
[Oo]bj/

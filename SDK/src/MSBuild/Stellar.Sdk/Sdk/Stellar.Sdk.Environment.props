<Project>
    <!-- Component versions of this SDK. Inside the core they come from its build files already -->
    <Import Project="Stellar.Versions.props" Condition="'$(StellarOrchesterVersion)' == '' and Exists('$(MSBuildThisFileDirectory)Stellar.Versions.props')"/>

    <!--
        Locating the installation ($STELLAR_ROOT, a checkout of StellarEngine-Core), in order of priority:
          1. the StellarRoot property (stellar modules build passes it, the core sets it for itself)
          2. the STELLAR_ROOT environment variable
          3. a directory above the project that contains manifests/engine.manifest.json
          4. the registry of the user, $STELLAR_HOME or ~/.stellar: installations.props, generated from
             installations.json by 'stellar install', gives the installation of this orchestra version
        The same order as Stellar.Tools.Environment.StellarInstallation.
    -->
    <PropertyGroup>
        <StellarRoot Condition="'$(StellarRoot)' == ''">$([System.Environment]::GetEnvironmentVariable('STELLAR_ROOT'))</StellarRoot>
    </PropertyGroup>
    <PropertyGroup Condition="'$(StellarRoot)' == ''">
        <_StellarManifestAbove>$([MSBuild]::GetDirectoryNameOfFileAbove('$(MSBuildProjectDirectory)', 'manifests/engine.manifest.json'))</_StellarManifestAbove>
        <StellarRoot Condition="'$(_StellarManifestAbove)' != ''">$(_StellarManifestAbove)</StellarRoot>
    </PropertyGroup>
    <PropertyGroup Condition="'$(StellarRoot)' == ''">
        <StellarHome Condition="'$(StellarHome)' == ''">$([System.Environment]::GetEnvironmentVariable('STELLAR_HOME'))</StellarHome>
        <StellarHome Condition="'$(StellarHome)' == '' and '$(OS)' == 'Windows_NT'">$(USERPROFILE)/.stellar</StellarHome>
        <StellarHome Condition="'$(StellarHome)' == '' and '$(OS)' != 'Windows_NT'">$(HOME)/.stellar</StellarHome>
        <StellarHome>$([MSBuild]::EnsureTrailingSlash('$(StellarHome)'))</StellarHome>
    </PropertyGroup>
    <Import Project="$(StellarHome)installations.props" Condition="'$(StellarRoot)' == '' and Exists('$(StellarHome)installations.props')"/>

    <!-- The layout of the installation: Stellar.Tools.Environment.StellarInstallation is the same tree in code -->
    <PropertyGroup Condition="'$(StellarRoot)' != ''">
        <StellarRoot>$([MSBuild]::EnsureTrailingSlash('$(StellarRoot)'))</StellarRoot>
        <StellarPackagesDir Condition="'$(StellarPackagesDir)' == ''">$(StellarRoot)packages/</StellarPackagesDir>
        <StellarArtifactsDir Condition="'$(StellarArtifactsDir)' == ''">$(StellarRoot)artifacts/</StellarArtifactsDir>
        <StellarModuleCatalog Condition="'$(StellarModuleCatalog)' == ''">$(StellarRoot)manifests/.generated/stellar.modules.props</StellarModuleCatalog>
    </PropertyGroup>

    <!--
        The catalog of the modules of a solution (a game's own libraries): .stellar/stellar.modules.props in the
        directory of the solution, written by 'stellar solution sync' and found from any project below it. Catalog.targets
        imports it after the catalog of the installation. Set the property to use another file, or to nothing for none.
    -->
    <PropertyGroup Condition="'$(StellarSolutionModuleCatalog)' == '' and '$(StellarUseSolutionModuleCatalog)' != 'false'">
        <_StellarSolutionCatalogAbove>$([MSBuild]::GetDirectoryNameOfFileAbove('$(MSBuildProjectDirectory)', '.stellar/stellar.modules.props'))</_StellarSolutionCatalogAbove>
        <StellarSolutionModuleCatalog Condition="'$(_StellarSolutionCatalogAbove)' != ''">$([MSBuild]::EnsureTrailingSlash('$(_StellarSolutionCatalogAbove)')).stellar/stellar.modules.props</StellarSolutionModuleCatalog>
    </PropertyGroup>

    <!--
        Which side of the engine a project is on. The engine side is everything of the installation but its games:
        the modules, the tools. It works on the engine as it is (sources in Debug) and builds into artifacts/. A game
        or a library, in projects/ or anywhere else, takes the engine from its packages and keeps bin/ and obj/ next
        to itself, as any .NET project.
    -->
    <PropertyGroup Condition="'$(StellarIsEngineProject)' == '' and '$(StellarRoot)' != ''">
        <_StellarProjectFolder>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)').ToLowerInvariant())</_StellarProjectFolder>
        <_StellarRootFolder>$([MSBuild]::NormalizeDirectory('$(StellarRoot)').ToLowerInvariant())</_StellarRootFolder>
        <StellarIsEngineProject Condition="$(_StellarProjectFolder.StartsWith('$(_StellarRootFolder)')) and !$(_StellarProjectFolder.StartsWith('$(_StellarRootFolder)projects'))">true</StellarIsEngineProject>
    </PropertyGroup>
    <PropertyGroup>
        <StellarIsEngineProject Condition="'$(StellarIsEngineProject)' == ''">false</StellarIsEngineProject>
        <StellarUseArtifactsOutput Condition="'$(StellarUseArtifactsOutput)' == '' and '$(StellarIsEngineProject)' != 'true'">false</StellarUseArtifactsOutput>
    </PropertyGroup>
</Project>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Stellar packages always come from the LOCAL feed of this installation: the engine is distributed as sources and
    built on the target machine. scripts/build.ps1 -Pack fills packages/, next to this file.
-->
<configuration>
    <packageSources>
        <clear/>
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3"/>
        <add key="StellarLocal" value="packages"/>
    </packageSources>
    <packageSourceMapping>
        <packageSource key="StellarLocal">
            <package pattern="Stellar.*"/>
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*"/>
        </packageSource>
    </packageSourceMapping>
</configuration>

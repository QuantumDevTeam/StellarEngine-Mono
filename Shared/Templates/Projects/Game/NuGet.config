<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <add key="StellarLocal" value="{{PackagesDirectory}}"/>
    </packageSources>
    <packageSourceMapping>
        <packageSource key="StellarLocal">
            <package pattern="Stellar.*"/>
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*"/>
        </packageSource>
    </packageSourceMapping>
</configuration>
